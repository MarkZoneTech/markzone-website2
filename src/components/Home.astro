---
import Base from '../layouts/Base.astro';
import { SITE, APPS } from '../data/site';
import type { HomeCopy } from '../i18n/home';
interface Props { t: HomeCopy; lang: 'en' | 'ar' }
const { t, lang } = Astro.props;
const p = lang === 'ar' ? '/ar' : '';
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: lang === 'ar' ? 'ar-AE' : 'en-AE',
  mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
}];
const wa = `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm4.5 12c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>`;
const nd = (x: string) => (/^[\d+<]/.test(x) ? 'ltr' : undefined);
const tick = '<svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>';
---
<Base title={t.title} description={t.description} lang={lang} alternate={{ en: '/', ar: '/ar' }} schema={schema}>
  <section class="hero">
    <svg class="hero__orbit" viewBox="0 0 800 800" aria-hidden="true">
      <ellipse cx="400" cy="400" rx="360" ry="300" transform="rotate(-24 400 400)" />
      <ellipse cx="400" cy="400" rx="300" ry="250" transform="rotate(-24 400 400)" />
      <path d="M250 420 L360 520 L620 250" />
    </svg>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__kicker">{t.kicker}</p>
        <h1>{t.h1a} <span>{t.h1b}</span></h1>
        <p class="hero__lead">{t.lead}</p>
        <div class="hero__ctas">
          <a class="btn btn--cta" href={SITE.whatsapp} rel="noopener"><Fragment set:html={wa} />{t.ctaWa}</a>
          <a class="btn btn--ghost" href="#apps">{t.ctaApps}</a>
        </div>
        <ul class="hero__trust">
          {t.trust.map(([b, s]) => <li><strong dir={nd(b)}>{b}</strong> {s}</li>)}
          <li><strong dir="ltr">{SITE.googleRating.value}★</strong> {t.ratingLabel.replace('{n}', String(SITE.googleRating.count))}</li>
        </ul>
      </div>
      <div class="hero__visual">
        <figure class="browser">
          <div class="browser__bar" dir="ltr"><span></span><span></span><span></span><em>{t.browserLabel}</em></div>
          <img src="/img/screens/oxpos-inventory.webp" alt={t.apps.oxpos.shotAlt} width="1200" height="539" loading="eager" fetchpriority="high" />
        </figure>
        <figure class="phone">
          <img src="/img/screens/texpos-measurements-m.webp" alt={t.apps.texpos.shotAlt} width="420" height="800" loading="eager" />
        </figure>
        <div class="hero__chip"><img src="/img/zaina-icon.webp" alt="" width="40" height="40" /><span><strong>ZainaApp</strong> {t.chipSub}</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap problem">
      <div class="problem__text">
        <span class="eyebrow">{t.whyEyebrow}</span>
        <h2>{t.whyH2}</h2>
        <p>{t.whyP}</p>
      </div>
      <ul class="problem__list">{t.pains.map(([h, d]) => <li><h3>{h}</h3><p>{d}</p></li>)}</ul>
    </div>
  </section>

  <section class="section section--muted" id="apps">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">{t.appsEyebrow}</span><h2>{t.appsH2}</h2><p>{t.appsP}</p></div>
      <div class="apps">
        {APPS.map((a) => { const c = t.apps[a.slug]; return (
          <article class={`app app--${a.tone}`} style={`--accent:${a.accent}`}>
            <div class={`app__shot ${a.slug === 'texpos' ? 'app__shot--phone' : ''}`}><img src={a.shot} alt={c.shotAlt} loading="lazy" /></div>
            <div class="app__top">
              <img class="app__logo" src={a.logo} alt={`${a.name} logo`} width="160" height="120" loading="lazy" />
              <span class="app__for">{c.for}</span>
            </div>
            <h3 class="visually-hidden">{a.name}</h3>
            <p class="app__problem">{c.problem}</p>
            <ul class="app__feats">{c.features.map((f) => <li>{f}</li>)}</ul>
            <p class="app__platform">{c.platform}</p>
            <div class="app__price">
              <span class="app__amount">{a.price} <small>{t.aed}</small></span>
              <span class="app__note">{c.priceNote}<br />{c.renewal}</span>
            </div>
            <a class="btn btn--outline app__link" href={`${p}/${a.slug}`}>{t.explore.replace('{name}', a.name)}</a>
          </article>
        ); })}
      </div>
      <div class="apps__foot">
        <p><strong>{t.hwLine}</strong> {t.hwRest}</p>
        <p class="soon"><span class="soon__label">{t.soonLabel}</span>{t.soon.map((s) => <span class="soon__chip">{s}</span>)}</p>
      </div>
    </div>
  </section>

  <section class="stats" aria-label={t.statsLabel}>
    <div class="wrap stats__grid">{t.stats.map(([n, l]) => <div><span class="stats__n" dir={nd(n)}>{n}</span><span class="stats__l">{l}</span></div>)}</div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">{t.svcEyebrow}</span><h2>{t.svcH2}</h2><p>{t.svcP}</p></div>
      <div class="svc">
        {t.services.map((s, i) => (
          <a class="svc__card" href={s.href}><span class="svc__num">0{i + 1}</span><h3>{s.h}</h3><p>{s.p}</p><span class="svc__tag">{s.t}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section included">
    <div class="wrap included__grid">
      <div>
        <span class="eyebrow eyebrow--light">{t.inclEyebrow}</span>
        <h2>{t.inclH2}</h2>
        <p>{t.inclP}</p>
        <a class="btn btn--cta" href={SITE.whatsapp} rel="noopener"><Fragment set:html={wa} />{t.inclCta}</a>
      </div>
      <ul class="included__list">
        {t.included.map(([h, d]) => <li><span class="included__icon"><Fragment set:html={tick} /></span><div><h3>{h}</h3><p>{d}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">{t.valEyebrow}</span><h2>{t.valH2}</h2><p>{t.valP}</p></div>
      <div class="why">{t.why.map(([h, d], i) => <div class="why__item"><span class="why__i">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{d}</p></div>)}</div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap faq">
      <div class="section-head"><span class="eyebrow">FAQ</span><h2>{t.faqTitle}</h2></div>
      <div class="faq__list">{t.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__in">
      <div><h2>{t.ctaTitle}</h2><p>{t.ctaText}</p></div>
      <div class="cta__btns">
        <a class="btn btn--cta" href={SITE.whatsapp} rel="noopener"><Fragment set:html={wa} />{lang === 'ar' ? t.ctaWa : `WhatsApp ${SITE.phone}`}</a>
        <a class="btn btn--ghost" href={SITE.phoneHref}>{t.ctaCall}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; background: radial-gradient(120% 90% at 85% 10%, #0a5aa8 0%, var(--navy) 45%, var(--navy-deep) 100%); color: #fff; padding-block: 88px 104px; }
  .hero__orbit { position: absolute; width: 900px; inset-inline-end: -220px; top: -120px; opacity: .16; pointer-events: none; }
  .hero__orbit ellipse { fill: none; stroke: var(--teal); stroke-width: 14; }
  .hero__orbit path { fill: none; stroke: var(--orange); stroke-width: 22; stroke-linecap: round; stroke-linejoin: round; }
  .hero__grid { position: relative; display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: center; }
  .hero__kicker { display: inline-block; font: 600 13px/1 var(--f-head); letter-spacing: .06em; text-transform: uppercase; color: #9fe6e7; background: rgba(6,171,174,.14); border: 1px solid rgba(6,171,174,.4); padding: 9px 14px; border-radius: 999px; margin-bottom: 26px; }
  .hero h1 { color: #fff; font-size: clamp(38px, 4.8vw, 58px); font-weight: 800; line-height: 1.06; letter-spacing: -.025em; margin-bottom: 22px; }
  .hero h1 span { display: block; color: #7fe0e1; }
  .hero__lead { font-size: 19px; color: #d6e3f5; max-width: 560px; margin-bottom: 34px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 40px; }
  .hero__trust { list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid rgba(255,255,255,.16); display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 15px; color: #c3d4ec; }
  .hero__trust strong { color: #fff; font-family: var(--f-head); font-size: 17px; margin-inline-end: 4px; }

  .hero__visual { position: relative; padding-bottom: 48px; }
  .browser { margin: 0; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,.35); transform: perspective(1400px) rotateY(-6deg); transform-origin: left center; }
  :global([dir="rtl"]) .browser { transform: perspective(1400px) rotateY(6deg); transform-origin: right center; }
  .browser__bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #eef2f7; border-bottom: 1px solid var(--border); }
  .browser__bar span { width: 9px; height: 9px; border-radius: 50%; background: #cbd3de; }
  .browser__bar em { font: 500 12px/1 var(--f-body); color: var(--ink-muted); font-style: normal; margin-inline-start: 10px; }
  .browser img { width: 100%; }
  .phone { position: absolute; inset-inline-end: -18px; bottom: 0; width: 30%; min-width: 120px; margin: 0; border: 7px solid #10151f; border-radius: 26px; overflow: hidden; background: #fff; box-shadow: 0 24px 48px rgba(0,0,0,.4); aspect-ratio: 9 / 17; }
  .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hero__chip { position: absolute; inset-inline-start: -16px; bottom: 6px; display: flex; align-items: center; gap: 12px; background: #fff; color: var(--ink); border-radius: 14px; padding: 10px 16px 10px 10px; box-shadow: var(--shadow-lg); }
  .hero__chip img { width: 40px; height: 40px; border-radius: 10px; background: #111; padding: 6px; }
  .hero__chip span { font-size: 13px; color: var(--ink-muted); line-height: 1.3; }
  .hero__chip strong { display: block; font: 700 15px/1.2 var(--f-head); color: var(--ink); }

  /* PROBLEM */
  .problem { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: start; }
  .problem h2 { font-size: clamp(26px, 3vw, 34px); color: var(--primary); }
  .problem__text p { color: var(--ink-muted); font-size: 18px; }
  .problem__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .problem__list li { border-inline-start: 4px solid var(--orange); background: var(--surface-muted); padding: 18px 22px; border-radius: 0 var(--r-sm) var(--r-sm) 0; }
  .problem__list h3 { font-size: 18px; margin-bottom: 4px; }
  .problem__list p { margin: 0; color: var(--ink-muted); }

  /* APPS */
  .apps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .app { position: relative; display: flex; flex-direction: column; background: #fff; border-radius: 20px; padding: 28px; box-shadow: var(--shadow); border-top: 5px solid var(--accent); }
  .app__shot { margin: -28px -28px 20px; height: 190px; overflow: hidden; background: #eef2f7; border-radius: 15px 15px 0 0; border-bottom: 1px solid var(--border); }
  .app__shot img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .app__shot--phone { display: flex; justify-content: center; align-items: flex-start; padding-top: 18px; background: linear-gradient(180deg, #f3ecdc, #e9dfc8); }
  .app__shot--phone img { width: 46%; height: auto; border: 5px solid #10151f; border-bottom: 0; border-radius: 18px 18px 0 0; }
  .app__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 72px; margin-bottom: 14px; }
  .app__logo { max-height: 64px; width: auto; max-width: 70%; object-fit: contain; }
  .app--tex .app__logo { max-height: 44px; }
  .app__for { font: 600 12px/1 var(--f-head); text-transform: uppercase; letter-spacing: .06em; color: var(--ink); background: color-mix(in srgb, var(--accent) 16%, white); padding: 8px 10px; border-radius: 999px; white-space: nowrap; }
  .app__problem { font-size: 16px; color: var(--ink); }
  .app__feats { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 10px; font-size: 15px; color: var(--ink-muted); }
  .app__feats li { position: relative; padding-inline-start: 26px; }
  .app__feats li::before { content: ""; position: absolute; inset-inline-start: 0; top: 7px; width: 14px; height: 8px; border-inline-start: 2.5px solid var(--teal-text); border-bottom: 2.5px solid var(--teal-text); transform: rotate(-45deg); }
  .app__platform { font-size: 14px; color: var(--ink-muted); font-style: italic; margin-top: auto; }
  .app__price { display: flex; align-items: center; gap: 14px; border-top: 1px dashed var(--border); padding-top: 18px; margin-bottom: 18px; }
  .app__amount { font: 800 32px/1 var(--f-head); color: var(--price); white-space: nowrap; }
  .app__amount small { font-size: 16px; font-weight: 700; }
  .app__note { font-size: 13px; line-height: 1.4; color: var(--ink-muted); }
  .app__link { width: 100%; }
  .apps__foot { margin-top: 36px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 32px; }
  .apps__foot p { margin: 0; color: var(--ink-muted); }
  .apps__foot strong { color: var(--ink); }
  .soon { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .soon__label { font: 700 13px/1 var(--f-head); text-transform: uppercase; letter-spacing: .06em; color: var(--teal-text); }
  .soon__chip { background: #fff; border: 1px solid var(--border); padding: 8px 14px; border-radius: 999px; font-size: 14px; color: var(--ink); }

  /* STATS */
  .stats { background: var(--teal-tint); padding-block: 48px; }
  .stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .stats__n { display: block; font: 800 clamp(30px, 3.4vw, 42px)/1.1 var(--f-head); color: var(--primary); margin-bottom: 6px; }
  .stats__l { display: block; font-size: 15px; color: var(--ink); max-width: 220px; }

  /* SERVICES */
  .svc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .svc__card { display: flex; flex-direction: column; padding: 32px; border: 1px solid var(--border); border-radius: 20px; text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s, transform .15s; }
  .svc__card:hover { border-color: var(--teal); box-shadow: var(--shadow); transform: translateY(-2px); }
  .svc__num { font: 700 14px/1 var(--f-head); color: var(--teal-text); margin-bottom: 24px; }
  .svc__card h3 { font-size: 21px; color: var(--primary); }
  .svc__card p { color: var(--ink-muted); flex: 1; }
  .svc__tag { font: 700 16px/1 var(--f-head); color: var(--price); }

  /* INCLUDED */
  .included { background: var(--navy); color: #d6e3f5; }
  .included__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: center; }
  .included h2 { color: #fff; font-size: clamp(28px, 3.2vw, 38px); }
  .included p { font-size: 18px; margin-bottom: 28px; }
  .eyebrow--light { color: #7fe0e1; }
  .included__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .included__list li { display: flex; gap: 14px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 22px; }
  .included__icon { flex: none; width: 36px; height: 36px; border-radius: 10px; background: var(--teal); display: grid; place-items: center; }
  .included__icon svg { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }
  .included__list h3 { color: #fff; font-size: 17px; margin-bottom: 4px; }
  .included__list p { font-size: 15px; margin: 0; color: #c3d4ec; }

  /* WHY */
  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
  .why__item { background: #fff; padding: 30px; }
  .why__i { font: 700 13px/1 var(--f-head); color: var(--orange); }
  .why__item h3 { font-size: 19px; margin: 14px 0 8px; }
  .why__item p { margin: 0; color: var(--ink-muted); }

  /* FAQ */
  .faq { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; }
  .faq__list details { background: #fff; border: 1px solid var(--border); border-radius: 14px; margin-bottom: 12px; }
  .faq__list summary { cursor: pointer; list-style: none; padding: 20px 24px; font: 600 17px/1.4 var(--f-head); display: flex; justify-content: space-between; gap: 16px; }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary::after { content: "+"; color: var(--teal-text); font-size: 24px; line-height: 1; }
  .faq__list details[open] summary::after { content: "–"; }
  .faq__list details p { padding: 0 24px 20px; margin: 0; color: var(--ink-muted); }

  /* CTA */
  .cta { background: linear-gradient(120deg, var(--navy-deep), var(--navy)); color: #d6e3f5; padding-block: 72px; }
  .cta__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .cta h2 { color: #fff; font-size: clamp(26px, 3vw, 36px); }
  .cta p { margin: 0; font-size: 18px; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 14px; }

  @media (max-width: 1020px) {
    .hero__grid, .problem, .included__grid, .faq { grid-template-columns: 1fr; gap: 40px; }
    .hero__visual { max-width: 520px; }
    .apps, .svc { grid-template-columns: 1fr; max-width: 560px; }
    .why { grid-template-columns: 1fr 1fr; }
    .stats__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .hero { padding-block: 56px 72px; }
    .hero__lead { font-size: 17px; }
    .hero__ctas .btn { width: 100%; }
    .phone { inset-inline-end: -6px; } .hero__chip { inset-inline-start: 0; }
    .included__list, .why { grid-template-columns: 1fr; }
    .cta__btns .btn { width: 100%; }
  }
  /* RTL adjustments */
  :global([dir="rtl"]) .hero__kicker { letter-spacing: 0; text-transform: none; font-family: var(--f-ar-head); font-size: 14px; }
  :global([dir="rtl"]) .hero h1 { font-family: var(--f-ar-head); letter-spacing: 0; line-height: 1.3; font-size: clamp(38px, 4.8vw, 60px); }
  :global([dir="rtl"]) .hero__trust strong { font-family: var(--f-ar-head); }
  :global([dir="rtl"]) .hero__orbit { inset-inline-end: auto; left: -220px; transform: scaleX(-1); }
  :global([dir="rtl"]) .phone { inset-inline-end: auto; left: -18px; }
  :global([dir="rtl"]) .hero__chip { inset-inline-start: auto; right: -16px; padding: 10px 10px 10px 16px; }
  :global([dir="rtl"]) .app__for, :global([dir="rtl"]) .soon__label { letter-spacing: 0; text-transform: none; font-family: var(--f-ar-head); font-size: 13px; }
  :global([dir="rtl"]) .stats__n[dir="ltr"] { text-align: right; }
  :global([dir="rtl"]) .app__amount, :global([dir="rtl"]) .stats__n, :global([dir="rtl"]) .svc__tag { font-family: var(--f-ar-head); }
  :global([dir="rtl"]) .app__feats li::before { transform: rotate(-45deg) scaleX(-1); }
  :global([dir="rtl"]) .app__shot img { object-position: right top; }
  :global([dir="rtl"]) .app__shot--phone img { object-position: top; }
  :global([dir="rtl"]) .faq__list summary { font-family: var(--f-ar-head); }
  :global([dir="rtl"]) .problem__list li { border-radius: var(--r-sm) 0 0 var(--r-sm); }
</style>
