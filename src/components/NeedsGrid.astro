---
interface Props { eyebrow: string; title: string; items: [string, string][]; lang?: 'en' | 'ar' }
const { eyebrow, title, items } = Astro.props;
---
<section class="section section--muted">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="ng__h">{title}</h2>
    <div class="ng">
      {items.map(([h, p]) => <div class="ng__item"><h3>{h}</h3><p>{p}</p></div>)}
    </div>
  </div>
</section>
<style>
  .ng__h { color: var(--primary); font-size: clamp(26px, 3vw, 34px); }
  .ng { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 28px; }
  .ng__item { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 22px; border-top: 4px solid var(--teal); }
  .ng__item h3 { font-size: 18px; margin-bottom: 6px; }
  .ng__item p { margin: 0; font-size: 16px; color: var(--ink-muted); }
  @media (max-width: 1020px) { .ng { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .ng { grid-template-columns: 1fr; } }
</style>
