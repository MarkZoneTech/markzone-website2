---
import { SITE } from '../data/site';
interface Props { points: [string, string][]; timeline: string; timelineLabel: string; waText: string; lang?: 'en' | 'ar' }
const { points, timeline, timelineLabel, waText, lang = 'en' } = Astro.props;
const L = lang === 'ar'
  ? { price: 'عرض الأسعار', cta: 'اطلب عرض سعر على الواتساب', inc: ['التجهيز والتركيب', 'دعم كامل على الواتساب يومياً من 10 الصبح لين 10 الليل (الأحد إجازة)', 'زيارات للموقع إذا احتاج الأمر'] }
  : { price: 'Quote on request', cta: 'Get a quote on WhatsApp', inc: ['Onboarding and setup', 'Full WhatsApp support, daily 10 AM – 10 PM (Sunday off)', 'On-site visits when needed'] };
---
<section class="section">
  <div class="wrap sb">
    <div class="sb__main">
      <slot />
      <div class="sb__points">{points.map(([h, p]) => <div class="sb__pt"><h3>{h}</h3><p>{p}</p></div>)}</div>
    </div>
    <aside class="sb__side">
      <p class="sb__label">{timelineLabel}</p>
      <p class="sb__big">{timeline}</p>
      <p class="sb__price">{L.price}</p>
      <a class="btn btn--cta" href={`${SITE.whatsapp}?text=${encodeURIComponent(waText)}`} rel="noopener">{L.cta}</a>
      <ul>{L.inc.map((i) => <li>{i}</li>)}</ul>
    </aside>
  </div>
</section>
<style>
  .sb { display: grid; grid-template-columns: 1.4fr .8fr; gap: 56px; align-items: start; }
  .sb__main :global(h2) { color: var(--primary); font-size: clamp(26px, 3vw, 34px); }
  .sb__main :global(p) { font-size: 18px; color: var(--ink-muted); }
  .sb__points { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
  .sb__pt { border: 1px solid var(--border); border-radius: 16px; padding: 22px; border-top: 4px solid var(--teal); }
  .sb__pt h3 { font-size: 18px; margin-bottom: 6px; }
  .sb__pt p { font-size: 16px !important; margin: 0; }
  .sb__side { position: sticky; top: 100px; background: var(--surface-muted); border-radius: 20px; padding: 30px; border-top: 6px solid var(--orange); }
  .sb__label { font: 600 13px/1 var(--f-head); text-transform: uppercase; letter-spacing: .08em; color: var(--teal-text); margin-bottom: 10px; }
  .sb__big { font: 800 34px/1.1 var(--f-head); color: var(--primary); margin-bottom: 6px; }
  .sb__price { font: 700 18px/1 var(--f-head); color: var(--price); margin-bottom: 22px; }
  .sb__side .btn { width: 100%; margin-bottom: 20px; }
  .sb__side ul { margin: 0; padding-inline-start: 18px; color: var(--ink-muted); font-size: 15px; display: grid; gap: 8px; }
  @media (max-width: 1020px) { .sb { grid-template-columns: 1fr; } .sb__side { position: static; } }
  @media (max-width: 600px) { .sb__points { grid-template-columns: 1fr; } }
  :global([dir="rtl"]) .sb__label { letter-spacing: 0; text-transform: none; font-family: var(--f-ar-head); font-size: 15px; }
  :global([dir="rtl"]) .sb__big, :global([dir="rtl"]) .sb__price { font-family: var(--f-ar-head); }
</style>
