---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Cta from './Cta.astro';
import { coverFor, blogBase, type Lang } from '../data/blog';
import { SERIES, GROUPS, getTutorials, mmss, isoDuration, ytThumb, type SeriesKey } from '../data/tutorials';
import { SITE } from '../data/site';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const base = blogBase(lang);
const pre = ar ? '/ar' : '';
const L = ar ? {
  title: 'شروحات فيديو لبرامج ماركزون | OxPOS و TexPOS',
  desc: 'شروحات فيديو بالعربي خطوة بخطوة لبرنامج OxPOS للمحلات وبرنامج TexPOS لمحلات الخياطة: البيع، المخزون، الموظفين، المقاسات والتقارير.',
  eyebrow: 'شروحات فيديو', h1: 'تعلّم برامج ماركزون خطوة بخطوة',
  lead: 'شروحات قصيرة بالعربي لكل شاشة في البرنامج، مع خطوات مكتوبة تحت كل فيديو. مناسبة لعملائنا الحاليين ولأي حد يبا يشوف البرنامج قبل ما يشتري.',
  blog: 'المدونة', lessons: (n: number) => `${n} دروس`, lesson: 'الدرس', yt: 'القائمة كاملة على يوتيوب', app: (n: string) => `تعرّف على ${n}`,
  price: { oxpos: '1,500 درهم مع السنة الأولى، وبعدها 500 درهم بالسنة', texpos: '1,000 درهم للسنة الأولى، وبعدها 500 درهم بالسنة', zainaapp: '1,500 درهم مع السنة الأولى، وبعدها 500 درهم بالسنة' },
  help: 'ما لقيت الشرح اللي تبحث عنه؟', helpP: 'فريقنا في الإمارات يرد عليك على الواتساب، يومياً من 10 الصبح لين 10 الليل (الأحد إجازة).', wa: 'كلمنا واتساب', jump: 'اختر البرنامج',
} : {
  title: 'Video Tutorials: OxPOS & TexPOS Step by Step | MarkZone',
  desc: 'Step-by-step video tutorials for OxPOS retail POS and TexPOS tailoring software: selling, stock, staff, measurements and reports. Narrated in Arabic.',
  eyebrow: 'Video tutorials', h1: 'Learn MarkZone apps step by step',
  lead: 'Short tutorials for every screen, each with written steps under the video. Made for our customers, and for anyone who wants to see the app before buying. Videos are narrated in Arabic.',
  blog: 'Blog', lessons: (n: number) => `${n} lessons`, lesson: 'Lesson', yt: 'Full playlist on YouTube', app: (n: string) => `Discover ${n}`,
  price: { oxpos: '1,500 AED including the first year, then 500 AED/year', texpos: '1,000 AED first year, then 500 AED/year', zainaapp: '1,500 AED including the first year, then 500 AED/year' },
  help: 'Can’t find the tutorial you need?', helpP: 'Our UAE team answers on WhatsApp, daily 10 AM – 10 PM (Sunday off).', wa: 'WhatsApp us', jump: 'Choose an app',
};

const order: SeriesKey[] = ['oxpos', 'texpos', 'zainaapp'];
const series = (await Promise.all(order.map(async (k) => ({ k, s: SERIES[k], posts: await getTutorials(lang, k) })))).filter((x) => x.posts.length);
const all = series.flatMap((x) => x.posts);
const url = `${SITE.url}${base}/tutorials`;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: L.h1, description: L.desc, url, inLanguage: ar ? 'ar-AE' : 'en-AE',
    publisher: { '@id': `${SITE.url}/#business` },
    mainEntity: {
      '@type': 'ItemList', numberOfItems: all.length,
      itemListElement: all.map((p, i) => ({
        '@type': 'ListItem', position: i + 1, url: `${SITE.url}${base}/${p.id}`,
        item: { '@type': 'VideoObject', name: p.data.title, description: p.data.description, thumbnailUrl: ytThumb(p.data.video!.id), uploadDate: p.data.video!.uploaded, duration: isoDuration(p.data.video!.duration), embedUrl: `https://www.youtube.com/embed/${p.data.video!.id}`, url: `${SITE.url}${base}/${p.id}` },
      })),
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ar ? 'الرئيسية' : 'Home', item: `${SITE.url}${pre || '/'}` },
      { '@type': 'ListItem', position: 2, name: L.blog, item: `${SITE.url}${base}` },
      { '@type': 'ListItem', position: 3, name: L.eyebrow, item: url },
    ],
  },
];
---
<Base lang={lang} title={L.title} description={L.desc} alternate={{ en: '/blog/tutorials', ar: '/ar/blog/tutorials' }} schema={schema}>
  <PageHero lang={lang} eyebrow={L.eyebrow} title={L.h1} lead={L.lead} crumb={[{ href: base, label: L.blog }, { href: `${base}/tutorials`, label: L.eyebrow }]}>
    <nav class="jump" aria-label={L.jump}>
      {series.map(({ k, s, posts }) => <a href={`#${k}`} style={`--c:${s.accent}`}><img src={s.logo} alt="" width="28" height="28" />{s.name}<small>{L.lessons(posts.length)}</small></a>)}
    </nav>
  </PageHero>

  {series.map(({ k, s, posts }, si) => {
    const groups = Object.keys(GROUPS).filter((g) => posts.some((p) => p.data.video!.group === g));
    return (
      <section class={`section ser ${si % 2 ? 'section--muted' : ''}`} id={k} style={`--c:${s.accent}`}>
        <div class="wrap">
          <header class="ser__h">
            <div>
              <h2>{s[lang].title}</h2>
              <p class="ser__lead">{s[lang].lead}</p>
              <p class="ser__price">{s.name}: <span dir={ar ? 'rtl' : 'ltr'}>{L.price[k]}</span></p>
            </div>
            <div class="ser__act">
              <a class="btn btn--primary" href={`${pre}/${s.page}`}>{L.app(s.name)}</a>
              {s.playlist && <a class="ser__yt" href={s.playlist} rel="noopener" target="_blank">{L.yt} ↗</a>}
            </div>
          </header>
          {groups.map((g) => (
            <div class="grp">
              <h3>{GROUPS[g][lang]}</h3>
              <ol class="cards">
                {posts.filter((p) => p.data.video!.group === g).map((p) => (
                  <li class="card">
                    <a href={`${base}/${p.id}`} class="card__img" tabindex="-1" aria-hidden="true">
                      <img src={coverFor(p, lang)} alt="" width="1200" height="630" loading="lazy" />
                      <span class="card__dur">{mmss(p.data.video!.duration)}</span>
                    </a>
                    <div class="card__b">
                      <p class="card__n">{L.lesson} {p.data.video!.lesson}</p>
                      <h4><a href={`${base}/${p.id}`}>{p.data.title}</a></h4>
                      <p class="card__d">{p.data.description}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="wrap help">
      <div><h2>{L.help}</h2><p>{L.helpP}</p></div>
      <a class="btn btn--cta" href={SITE.whatsapp} rel="noopener">{L.wa}</a>
    </div>
  </section>
  <Cta lang={lang} />
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .jump a { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px 10px 12px; background: #fff; color: var(--ink); border-radius: 999px; text-decoration: none; font-weight: 700; border-bottom: 3px solid var(--c); }
  .jump img { width: 28px; height: 28px; object-fit: contain; }
  .jump small { font-weight: 500; color: var(--ink-muted); }
  .ser__h { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; padding-bottom: 24px; margin-bottom: 32px; border-bottom: 3px solid var(--c); }
  .ser__h h2 { font-size: clamp(26px, 3vw, 34px); color: var(--primary); margin-bottom: 8px; }
  .ser__lead { color: var(--ink-muted); max-width: 640px; margin-bottom: 8px; }
  .ser__price { font-weight: 600; color: var(--price, #B35600); margin: 0; }
  .ser__act { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .ser__yt { font-size: 14px; color: var(--primary); }
  .grp + .grp { margin-top: 40px; }
  .grp h3 { font-size: 21px; margin-bottom: 18px; display: flex; align-items: center; gap: 10px; }
  .grp h3::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: #fff; transition: box-shadow .15s, transform .15s; }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .card__img { position: relative; display: block; }
  .card__img img { width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; }
  .card__dur { position: absolute; bottom: 10px; inset-inline-end: 10px; background: rgba(0,0,0,.78); color: #fff; font-size: 13px; font-weight: 600; padding: 3px 8px; border-radius: 6px; direction: ltr; }
  .card__b { padding: 18px 20px 20px; }
  .card__n { font: 600 12px/1 var(--f-head); text-transform: uppercase; letter-spacing: .08em; color: var(--teal-text); margin-bottom: 8px; }
  .card h4 { font-size: 18px; line-height: 1.35; margin-bottom: 6px; }
  .card h4 a { color: var(--ink); text-decoration: none; }
  .card h4 a:hover { color: var(--primary); }
  .card__d { font-size: 15px; color: var(--ink-muted); margin: 0; }
  .help { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; border: 1px solid var(--border); border-radius: 20px; padding: 28px 32px; border-top: 5px solid var(--orange); }
  .help h2 { font-size: 24px; margin-bottom: 6px; } .help p { margin: 0; color: var(--ink-muted); }
  @media (max-width: 1020px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .cards { grid-template-columns: 1fr; } .ser__act { align-items: flex-start; } }
  :global([dir="rtl"]) .card__n { letter-spacing: 0; text-transform: none; font-family: var(--f-ar-head); font-size: 14px; }
  :global([dir="rtl"]) .jump a { padding: 10px 12px 10px 18px; }
</style>
