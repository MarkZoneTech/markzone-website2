---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props { title: string; h1: string; description: string; path: string; updated: string }
const { title, h1, description, path, updated } = Astro.props;
---
<Base title={title} description={description} alternate={{ en: path, ar: `/ar${path}` }}>
  <PageHero eyebrow="Legal" title={h1} lead={`Last updated: ${updated}`} />
  <section class="section"><div class="wrap legal"><slot /></div></section>
</Base>
<style>
  .legal { max-width: 780px; }
  .legal :global(h2) { font-size: 22px; color: var(--primary); margin-top: 36px; }
  .legal :global(p), .legal :global(li) { color: var(--ink-muted); font-size: 17px; }
</style>
