---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props { title: string; h1: string; description: string; path: string; updated: string; lang?: 'en' | 'ar' }
const { title, h1, description, path, updated, lang = 'en' } = Astro.props;
---
<Base title={title} description={description} lang={lang} alternate={{ en: path, ar: `/ar${path}` }}>
  <PageHero lang={lang} eyebrow={lang === 'ar' ? 'قانوني' : 'Legal'} title={h1} lead={lang === 'ar' ? `آخر تحديث: ${updated}` : `Last updated: ${updated}`} />
  <section class="section"><div class="wrap legal"><slot /></div></section>
</Base>
<style>
  .legal { max-width: 780px; }
  .legal :global(h2) { font-size: 22px; color: var(--primary); margin-top: 36px; }
  .legal :global(p), .legal :global(li) { color: var(--ink-muted); font-size: 17px; }
</style>
