---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { SITE } from '../../data/site';
const items = [
  { name: 'MadaPOS', for: 'مطاعم وكافيهات', slug: 'madapos' },
  { name: 'AqarOS', for: 'مكاتب العقارات', slug: 'aqaros' },
];
---
<Base lang="ar" title="قريباً: MadaPOS و AqarOS | ماركزون تكنولوجي" description="تطبيقات جديدة من ماركزون قريباً: MadaPOS للمطاعم والكافيهات، وAqarOS لمكاتب العقارات في الإمارات. سجل اهتمامك على الواتساب." alternate={{ en: '/coming-soon', ar: '/ar/coming-soon' }}>
  <PageHero lang="ar" eyebrow="قريباً" title="تطبيقات جديدة في الطريق" lead="نسوي تطبيق لكل مجال. وهذي اللي بعدها." crumb={[{ href: '/ar/coming-soon', label: 'قريباً' }]} />
  <section class="section">
    <div class="wrap soon">
      {items.map((i) => (
        <article class="soon__card" id={i.slug}>
          <span class="soon__badge">قريباً</span>
          <h2>{i.name}</h2>
          <p>{i.for}</p>
          <a class="btn btn--outline" href={`${SITE.whatsapp}?text=${encodeURIComponent(`مرحبا ماركزون، خبروني لما ينطلق ${i.name}`)}`} rel="noopener">خبروني لما ينطلق</a>
        </article>
      ))}
    </div>
  </section>
  <Cta lang="ar" title="عندك محل أو صالون أو محل خياطة؟" text="OxPOS وZainaApp وTexPOS شغالين الحين. اسألنا أي واحد يناسبك." />
</Base>
<style>
  .soon { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .soon__card { border: 1px solid var(--border); border-radius: 20px; padding: 36px; border-top: 5px solid var(--teal); }
  .soon__badge { display: inline-block; font: 700 14px/1 var(--f-ar-head); color: var(--teal-text); background: var(--teal-tint); padding: 8px 12px; border-radius: 999px; margin-bottom: 18px; }
  .soon__card h2 { color: var(--primary); font-size: 32px; margin-bottom: 4px; font-family: var(--f-head); }
  .soon__card p { font-size: 18px; color: var(--ink-muted); margin-bottom: 24px; }
  @media (max-width: 720px) { .soon { grid-template-columns: 1fr; } }
</style>
