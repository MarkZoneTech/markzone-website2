---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../data/site';
const maps = SITE.googleMaps;
const cards = [
  { h: 'واتساب', v: SITE.phone, href: SITE.whatsapp, note: 'أسرع طريقة توصل لنا', cta: true, ltr: true },
  { h: 'اتصال', v: SITE.phone, href: SITE.phoneHref, note: 'يومياً 10 الصبح – 10 الليل · الأحد إجازة', ltr: true },
  { h: 'الإيميل', v: SITE.email, href: `mailto:${SITE.email}`, note: 'لعروض الأسعار والمستندات', ltr: true },
  { h: 'إنستغرام', v: SITE.instagramHandle, href: SITE.instagram, note: 'تابع أخبارنا', ltr: true },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'تواصل مع ماركزون تكنولوجي', url: `${SITE.url}/ar/contact`, inLanguage: 'ar-AE', about: { '@id': `${SITE.url}/#business` } }];
---
<Base lang="ar" title="تواصل مع ماركزون تكنولوجي | واتساب أو اتصال أو زيارة في دبي" description="تواصل مع ماركزون تكنولوجي في دبي: واتساب أو اتصال على ‎+971 50 655 2181. الدعم يومياً من 10 الصبح لين 10 الليل، الأحد إجازة. نخدم الإمارات السبع." alternate={{ en: '/contact', ar: '/ar/contact' }} schema={schema}>
  <PageHero lang="ar" eyebrow="تواصل معنا" title="كلّم ناس حقيقيين في الإمارات" lead="الواتساب أسرع طريقة توصل لنا. موجودين يومياً من 10 الصبح لين 10 الليل، والأحد إجازة." crumb={[{ href: '/ar/contact', label: 'تواصل' }]} />
  <section class="section">
    <div class="wrap">
      <div class="cards">
        {cards.map((c) => (
          <a class={`card ${c.cta ? 'card--cta' : ''}`} href={c.href} rel="noopener">
            <span class="card__h">{c.h}</span>
            <span class="card__v" dir="ltr">{c.v}</span>
            <span class="card__n">{c.note}</span>
          </a>
        ))}
      </div>
      <div class="visit">
        <div>
          <h2>مكتبنا</h2>
          <p dir="ltr" style="text-align:right">{SITE.address.street}, Dubai, UAE</p>
          <p>نخدم الشركات في الإمارات السبع، ونزورك في موقعك إذا احتاج الأمر.</p>
          <a class="btn btn--outline" href={maps} rel="noopener">افتح في خرائط جوجل</a>
        </div>
        <div>
          <h2>أوقات الدعم</h2>
          <p>يومياً من 10 الصبح لين 10 الليل · الأحد إجازة</p>
          <h2>الشخص المسؤول</h2>
          <p>Fadi A. Abouzoor، مدير المبيعات</p>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 48px; }
  .card { display: flex; flex-direction: column; gap: 6px; padding: 26px; border: 1px solid var(--border); border-radius: 18px; text-decoration: none; transition: box-shadow .15s, transform .15s; }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .card--cta { background: var(--navy); border-color: var(--navy); }
  .card__h { font: 700 15px/1 var(--f-ar-head); color: var(--teal-text); }
  .card--cta .card__h { color: #7fe0e1; }
  .card__v { font: 700 17px/1.3 var(--f-head); color: var(--ink); overflow-wrap: anywhere; text-align: right; }
  .card--cta .card__v { color: #fff; }
  .card__n { font-size: 14px; color: var(--ink-muted); }
  .card--cta .card__n { color: #c3d4ec; }
  .visit { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; background: var(--surface-muted); border-radius: 20px; padding: 36px; }
  .visit h2 { font-size: 20px; color: var(--primary); }
  .visit p { color: var(--ink-muted); }
  @media (max-width: 1020px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .cards, .visit { grid-template-columns: 1fr; } }
</style>
