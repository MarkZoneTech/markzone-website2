---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceBody from '../../components/ServiceBody.astro';
import NeedsGrid from '../../components/NeedsGrid.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { SITE } from '../../data/site';
const faq: [string, string][] = [
  ['تطبيق الجوال ياخذ كم وقت؟', 'تطبيق الجوال يتبني فوق تطبيق ويب، يعني مدته هي مدة بناء تطبيق الويب زائد شهر إضافي.'],
  ['بكم تطبيق الجوال؟', 'الأسعار تختلف وايد حسب حجم التطبيق، عشان جي كل مشروع يتسعّر لحاله بعد استشارة مجانية، مع عرض سعر واضح وبدون تكاليف مخفية.'],
  ['ليش تطبيق الجوال يحتاج تطبيق ويب؟', 'تطبيق الجوال يعتمد على تطبيق الويب اللي وراه، وفيه بياناتك ومنطق الشغل. عشان جي نبني الثنين مع بعض، ومدة التسليم هي مدة تطبيق الويب زائد شهر.'],
  ['تطبيقاتكم الجاهزة هي تطبيقات جوال؟', 'لا. OxPOS وZainaApp وTexPOS تشتغل على أي جهاز. وخدمة تطبيقات الجوال للتطبيقات الخاصة بس.'],
  ['في استشارة مجانية؟', 'إيه. نسمع عن شغلك ونعرف شو اللي يبطّئه، ونوصي بالشي المناسب نبنيه، مع المدة والسعر.'],
  ['شو الدعم اللي بحصّله بعد التسليم؟', 'كل عميل ياخذ دعم كامل على الواتساب يومياً من 10 الصبح لين 10 الليل (الأحد إجازة)، وزيارات للموقع إذا احتاج الأمر. وشروط الدعم المستمر بعد التسليم نتفق عليها لكل مشروع، حسب حجمه.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'تطوير تطبيقات الجوال حسب الطلب', serviceType: 'Mobile app development', provider: { '@id': `${SITE.url}/#business` }, areaServed: 'AE', url: `${SITE.url}/ar/mobile-apps`, inLanguage: 'ar-AE' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base lang="ar" title="تطوير تطبيقات جوال حسب الطلب في دبي | ماركزون" description="تطبيقات جوال حسب الطلب للشركات في الإمارات: تطبيق للعملاء أو الموظفين أو المالك أو الولاء أو التوصيل، فوق تطبيق الويب. استشارة مجانية ودعم محلي." alternate={{ en: '/mobile-apps', ar: '/ar/mobile-apps' }} schema={schema}>
  <PageHero lang="ar" eyebrow="تطبيقات الجوال" title="تطبيق جوال خاص فيك، مبني على طريقة شغلك" lead="خل عملاءك وموظفينك ونفسك يكون عندكم تطبيق في التلفون. نبنيه فوق تطبيق الويب حقك، وكل شي يظل متزامن." crumb={[{ href: '/ar/mobile-apps', label: 'تطبيقات الجوال' }]} />
  <ServiceBody lang="ar" timelineLabel="المدة" timeline="تطبيق الويب + شهر" waText="مرحبا ماركزون، أبا أتكلم عن تطبيق جوال" points={[
    ['مبني على تطبيق الويب', 'التطبيق والنظام اللي وراه يشتغلون مع بعض، والتحديثات تنزل مباشرة.'],
    ['مبني على طريقة شغلك', 'نصممه على طريقة شغل عملاءك وفريقك الحقيقية.'],
    ['استشارة مجانية أول', 'نوصي بالشي المناسب نبنيه، مع المدة والسعر.'],
    ['دعم محلي حقيقي', 'دعم على الواتساب يومياً وزيارات للموقع إذا احتاج الأمر.'],
  ]}>
    <span class="eyebrow">ليش تطبيق جوال</span>
    <h2>قناة مباشرة مع عملاءك وفريقك</h2>
    <p>تطبيق الجوال يوصّل شغلك لتلفونات عملاءك، ويعطيك وفريقك معلومات مباشرة وين ما كنتوا.</p>
    <p>تطبيق الجوال يعتمد على تطبيق الويب اللي وراه، يعني مدته هي مدة بناء تطبيق الويب زائد شهر إضافي. وإذا تحتاج نظام الويب أول، شوف <a href="/ar/custom-software">البرامج حسب الطلب</a>.</p>
    <p>الأسعار تختلف وايد حسب حجم التطبيق، عشان جي كل مشروع يتسعّر بعد استشارة مجانية.</p>
  </ServiceBody>
  <NeedsGrid lang="ar" eyebrow="شو نبني" title="أي تطبيق تحتاج؟" items={[
  ['تطبيق للعملاء', 'العملاء يطلبون أو يحجزون أو يتابعون من تلفونهم، وتصير عندك قناة مباشرة وزبائن يرجعون.'],
  ['تطبيق للموظفين أو الميدان', 'فريقك يشتغل من تلفوناتهم والتحديثات تنزل مباشرة.'],
  ['تطبيق للمالك', 'تتابع المبيعات والتقارير من أي مكان.'],
  ['تطبيق ولاء أو عضوية', 'العملاء يرجعون عشان النقاط والعروض.'],
  ['تطبيق توصيل أو سائقين', 'توزع التوصيلات وتتابعها لحظة بلحظة.'],
  ['أي احتياج ثاني', 'نلقاه مع بعض في الاستشارة المجانية.'],
]} />
  <Faq lang="ar" items={faq} title="أسئلة عن تطبيقات الجوال" />
  <Cta lang="ar" title="قول لنا عن التطبيق اللي تبا" text="اشرح لنا فكرتك على الواتساب ونرتب لك الاستشارة المجانية." />
</Base>
