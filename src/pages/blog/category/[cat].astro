---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogList from '../../../components/BlogList.astro';
import Cta from '../../../components/Cta.astro';
import { getPosts, CAT_LABELS } from '../../../data/blog';
export async function getStaticPaths() {
  const posts = await getPosts('en');
  return Object.keys(CAT_LABELS.en).map((cat) => ({ params: { cat }, props: { posts: posts.filter((p) => p.data.category === cat) } })).filter((x) => x.props.posts.length);
}
const { cat } = Astro.params;
const { posts } = Astro.props;
const name = CAT_LABELS.en[cat!];
---
<Base title={`${name} | MarkZone Blog`} description={`${name} articles for UAE business owners from MarkZone Technology in Dubai.`} alternate={{ en: `/blog/category/${cat}`, ar: `/ar/blog/category/${cat}` }}>
  <PageHero eyebrow="Blog" title={name} crumb={[{ href: '/blog', label: 'Blog' }, { href: `/blog/category/${cat}`, label: name }]} />
  <BlogList posts={posts} active={cat} />
  <Cta />
</Base>
