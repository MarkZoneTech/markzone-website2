---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
import CallbackForm from '../components/partner/CallbackForm.tsx';
const maps = SITE.googleMaps;
const cards = [
  { h: 'WhatsApp', v: SITE.phone, href: SITE.whatsapp, note: 'Fastest way to reach us', cta: true },
  { h: 'Call', v: SITE.phone, href: SITE.phoneHref, note: SITE.hours },
  { h: 'Email', v: SITE.email, href: `mailto:${SITE.email}`, note: 'For quotes and documents' },
  { h: 'Instagram', v: SITE.instagramHandle, href: SITE.instagram, note: 'Follow our updates' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact MarkZone Technology', url: `${SITE.url}/contact`, about: { '@id': `${SITE.url}/#business` } }];
---
<Base title="Contact MarkZone Technology | WhatsApp, Call or Visit in Dubai" description="Contact MarkZone Technology in Dubai: WhatsApp or call +971 50 655 2181. Support daily 10 AM – 10 PM, Sunday off. Serving all 7 emirates." alternate={{ en: '/contact', ar: '/ar/contact' }} schema={schema}>
  <PageHero eyebrow="Contact" title="Talk to a real person in the UAE" lead="WhatsApp is the fastest way to reach us. We’re available daily from 10 AM to 10 PM, Sunday off." crumb={[{ href: '/contact', label: 'Contact' }]} />
  <section class="section">
    <div class="wrap">
      <div class="cards">
        {cards.map((c) => (
          <a class={`card ${c.cta ? 'card--cta' : ''}`} href={c.href} rel="noopener">
            <span class="card__h">{c.h}</span>
            <span class="card__v">{c.v}</span>
            <span class="card__n">{c.note}</span>
          </a>
        ))}
      </div>
      <div class="callback"><CallbackForm client:visible lang="en" /></div>
      <div class="visit">
        <div>
          <h2>Our office</h2>
          <p>{SITE.address.street}, Dubai, UAE</p>
          <p>Serving businesses in all 7 emirates, with on-site visits when the situation requires.</p>
          <a class="btn btn--outline" href={maps} rel="noopener">Open in Google Maps</a>
        </div>
        <div>
          <h2>Support hours</h2>
          <p>{SITE.hours}</p>
          <h2>Contact person</h2>
          <p>Fadi A. Abouzoor, Sales Manager</p>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 48px; }
  .card { display: flex; flex-direction: column; gap: 6px; padding: 26px; border: 1px solid var(--border); border-radius: 18px; text-decoration: none; transition: box-shadow .15s, transform .15s; }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .card--cta { background: var(--navy); border-color: var(--navy); }
  .card__h { font: 600 13px/1 var(--f-head); text-transform: uppercase; letter-spacing: .08em; color: var(--teal-text); }
  .card--cta .card__h { color: #7fe0e1; }
  .card__v { font: 700 18px/1.3 var(--f-head); color: var(--ink); overflow-wrap: anywhere; }
  .card--cta .card__v { color: #fff; }
  .card__n { font-size: 14px; color: var(--ink-muted); }
  .card--cta .card__n { color: #c3d4ec; }
  .callback { max-width: 620px; margin: 0 auto 48px; }
  .visit { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; background: var(--surface-muted); border-radius: 20px; padding: 36px; }
  .visit h2 { font-size: 20px; color: var(--primary); }
  .visit p { color: var(--ink-muted); }
  @media (max-width: 1020px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .cards, .visit { grid-template-columns: 1fr; } }
</style>
