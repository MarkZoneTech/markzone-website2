---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBody from '../components/ServiceBody.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import NeedsGrid from '../components/NeedsGrid.astro';
import { SITE } from '../data/site';
const faq: [string, string][] = [
  ['How long does custom software take?', 'Custom software (web apps) is delivered from about 2 months, depending on the size of the project.'],
  ['How long does a mobile app take?', 'A mobile app is built on top of a web app, so its timeline is the web app build time plus 1 extra month. See our mobile apps page for details.'],
  ['How much does custom software cost?', 'Prices vary a lot with the size of the software or app, so every project is priced individually after a free consultation, with a clear quote and no hidden costs.'],
  ['Is there a free consultation?', 'Yes. We listen to your business, find what is slowing it down, and recommend what to build, with a timeline and a price.'],
  ['Can you move our data from Excel?', 'Yes. Data migration from Excel is included where available.'],
  ['Do you work with larger companies?', 'Our focus today is SMEs, from single shops to multi-branch groups. Enterprise and governance solutions are on our roadmap and will be rolled out in stages.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Custom software development', serviceType: 'Software development', provider: { '@id': `${SITE.url}/#business` }, areaServed: 'AE', url: `${SITE.url}/custom-software`, description: 'Custom web software for UAE SMEs, built around how the business works and delivered from about 2 months depending on size.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Custom Software Development in Dubai | MarkZone" description="Custom web software for UAE SMEs, built around how you work and delivered from about 2 months. Free consultation and local WhatsApp support." alternate={{ en: '/custom-software', ar: '/ar/custom-software' }} schema={schema}>
  <PageHero eyebrow="Custom software (web apps)" title="Software built around exactly how you work" lead="When a ready-made app doesn’t fit, we build one that does. From the first conversation to full delivery, it’s designed around your workflow." crumb={[{ href: '/custom-software', label: 'Custom Software' }]} />
  <ServiceBody timelineLabel="Full delivery" timeline="From ~2 months" waText="Hi MarkZone, I'd like to discuss a custom software project" points={[
    ['Built around your workflow', 'We organize the system around how your team already works.'],
    ['Onboarding & setup', 'We set it up and train your team.'],
    ['Data migration from Excel', 'Bring your existing data with you, where available.'],
    ['Support that stays', 'WhatsApp support daily and on-site visits when the situation requires.'],
  ]}>
    <span class="eyebrow">Why custom</span>
    <h2>Organized from day one</h2>
    <p>Most SMEs don’t struggle because of marketing. They struggle because the business isn’t organized internally. A system built for your exact process removes the spreadsheets, the notebooks and the guesswork.</p>
    <p>Delivery depends on the size of the project, starting from about 2 months for a fully delivered system. Want your own phone app too? It is built on top of the web app, so see <a href="/mobile-apps">custom mobile apps</a>.</p>
    <p>Every project starts with a free consultation, where we recommend what to build, with a timeline and a price.</p>
  </ServiceBody>
  <NeedsGrid eyebrow="What we build" title="Custom software for how your business really works" items={[
  ['Run my operations', 'Everything in one place instead of Excel and paper, and decisions based on real numbers.'],
  ['Customers and follow-ups', 'No customer or lead is forgotten, and more sales come from people who already know you.'],
  ['Orders, jobs and projects', 'Everyone knows the status of every item, with fewer mistakes and delays.'],
  ['Bookings and reservations', 'A booking system built for your business, with no double bookings.'],
  ['Portals', 'Customers and staff see their own data without calling you.'],
  ['Reports and dashboards', 'You see sales and performance live, on your own numbers.'],
  ['Multi-branch', 'One platform for all locations.'],
  ['Company flows', 'Your steps (request, approval, execution, delivery) are set up in the system, so nothing falls through the cracks and nobody chases people.'],
  ['AI automations', 'AI takes over repetitive daily work, saving staff hours and giving customers faster answers.'],
]} />
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">On our roadmap</span>
      <h2 style="color:var(--primary)">Enterprise & governance solutions</h2>
      <p style="font-size:18px;color:var(--ink-muted)">Our vision is to bring the solutions we built for SMEs to large-scale businesses. Enterprise and governance solutions will be rolled out in stages.</p>
    </div>
  </section>
  <Faq items={faq} title="Custom software questions" />
  <Cta title="Tell us what you need built" text="Describe your process on WhatsApp and we’ll set up your free consultation." />
</Base>
