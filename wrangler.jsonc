{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markzone-website2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
